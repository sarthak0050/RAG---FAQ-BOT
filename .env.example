# Copy to `.env` and fill in. `.env` is ignored by git.
# The app reads these values from the environment at runtime.

# Mistral API key (required for answer generation).
# Get one at https://console.mistral.ai/
MISTRAL_API_KEY=

# Mistral model used for grounded, facts-only answers.
MISTRAL_MODEL=mistral-small-latest

# Scheduler polling interval (hours) when running `python -m code.scheduler --mode daemon`.
# Optional; the CLI flag --interval-hours overrides this.
# REFRESH_INTERVAL_HOURS=24